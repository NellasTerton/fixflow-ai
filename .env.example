# Public application URL. No external integration uses it yet.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pooled Neon connection used by the Next.js application at runtime.
DATABASE_URL=

# Direct Neon connection used only by Drizzle Kit for migrations.
DATABASE_URL_DIRECT=

# Claude Messages API. Keep the key only in .env.local / hosting secrets.
LLM_BASE_URL=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=

# Reserved for a future outbound Make/n8n webhook. Not used yet.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
